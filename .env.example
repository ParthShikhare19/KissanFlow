# ============================================================
# AnnSetu — Environment Variables
# Copy this file to .env and fill in your actual values
# ============================================================

# --- Database ---
# Docker Compose starts this PostgreSQL database automatically. Replace with a
# managed PostgreSQL URL for a deployed environment.
DATABASE_URL=postgresql+asyncpg://annsetu:annsetu@localhost:5432/annsetu

# --- JWT Auth ---
JWT_SECRET=change-this-to-a-random-string-at-least-32-characters-long
JWT_REFRESH_SECRET=change-this-to-another-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Server ---
PORT=8000
CLIENT_URL=http://localhost:5173
ENVIRONMENT=development

# --- Redis (used for Socket.IO pub/sub and Celery) ---
REDIS_URL=redis://localhost:6379

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
