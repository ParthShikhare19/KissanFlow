# KissanFlow Backend Environment Template
# Copy this to .env and fill in your values

# PostgreSQL (Neon DB or local PostgreSQL)
DATABASE_URL="postgresql+asyncpg://user:password@host/dbname?ssl=require"

# Redis
REDIS_URL=redis://localhost:6379

# JWT secrets — use strong random strings in production
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
REFRESH_SECRET_KEY=your-refresh-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Application
APP_ENV=development
DEBUG=true

# Twilio IVR Helpline
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+911800XXXXXXX
IVR_BASE_URL=https://your-domain.com   # ngrok URL for local dev
